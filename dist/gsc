        end

        puts "#{Color::BOLD}  # | Date       | Source                | Keywords | Seed / File#{Color::RESET}"
        puts "  --------------------------------------------------------------------------------"
        list.each_with_index do |item, idx|
          num = "[#{idx + 1}]".rjust(4)
