        puts Color.c("❌ Error: Target URL or domain required. Example: gsc schema https://mybrand.com", Color::RED)
        return
      end
      url = raw.to_s.start_with?('http') ? raw : "https://#{raw}"
      sv = GSC::SchemaValidator.new(url)
      data = sv.audit

