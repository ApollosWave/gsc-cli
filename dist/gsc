          puts ""
        end
      else
        content = llms.generate_llms_txt
        if options[:save]
          File.write("llms.txt", content)
          puts Color.c("✅ Successfully wrote llms.txt to current directory!", Color::GREEN)
        else
          puts content
        end
      end
