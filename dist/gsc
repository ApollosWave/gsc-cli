        puts JSON.pretty_generate(data)
        return
      end

      puts BANNER unless options[:in_dashboard]
      puts "📦 #{Color::BOLD}STRUCTURED DATA & RICH SNIPPET VALIDATION:#{Color::RESET} #{Color.c(url, Color::CYAN)}"
