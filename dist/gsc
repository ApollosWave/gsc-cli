            elsif obj.is_a?(Hash)
              rows = obj[:rows] || obj['rows'] || obj[:queries] || obj['queries'] ||
                     obj[:pages] || obj['pages'] || obj[:all_results] || obj['all_results'] ||
                     obj[:playbooks] || obj['playbooks'] || obj[:categories] || obj['categories'] ||
