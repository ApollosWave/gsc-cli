        puts "#{Color.bold("───────────────────────────────────────────────────────────────────────────")}\n"

        if res[:shifts].empty?
          puts "  ℹ️  No search query intent shift data found for #{res[:domain]}."
          puts "     Connect Google Search Console credentials via `gsc setup` or specify a verified property with `--domain <domain>`."
          puts "\n#{Color.bold("═══════════════════════════════════════════════════════════════════════════")}\n"
