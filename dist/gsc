          end
          return
        end
        target_domain = target_domain.sub(%r{^https?://}, '').sub(%r{/.*$}, '')

        puts "🎯 Tracking search intent drift & landing page mismatches for #{Color.cyan(target_domain)}..." unless options[:json]

