      def print_batch_summary(*args, &blk); Indexing.print_batch_summary(*args, &blk); end

      # GA4 Error Handling
      def handle_ga4_api_error(*args, &blk); GA4.handle_ga4_api_error(*args, &blk); end
    end
  end
end

